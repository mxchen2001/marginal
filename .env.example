# .env.example

# Database
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=your_service_role_key

# Prediction Markets
KALSHI_API_KEY=
POLYMARKET_API_KEY=          # optional, most endpoints are public

# News & Search
NEWSAPI_KEY=
TAVILY_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=marginal/0.1

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=              # for embeddings only

# Loop Config
LOOP_INTERVAL_MINUTES=30
MIN_EDGE_THRESHOLD=0.05       # 5% edge minimum
MAX_POSITION_USD=50
MAX_DAILY_LOSS_USD=200
DRY_RUN=true                  # set false to enable live execution